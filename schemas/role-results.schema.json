{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://looprch.dev/schemas/role-results.schema.json",
  "title": "The looprch-result block at the end of every role's final message (protocol 5)",
  "description": "Documentation schema. The CLI validates with src/core/results.ts (validateResult): the block must parse, carry the role and an allowed decision, and have the shapes below. Expansion requests must name SEV3 document or phase ids. There are no other result checks.",
  "type": "object",
  "required": ["role", "decision"],
  "properties": {
    "role": { "enum": ["planner", "plan_debater", "implementer", "tester", "reviewer", "worker"] },
    "run_id": { "type": "string" },
    "decision": { "type": "string" },
    "expansion_requests": { "type": "array", "items": { "$ref": "#/$defs/expansion" }, "description": "Required with needs_expansion" }
  },
  "oneOf": [
    {
      "properties": {
        "role": { "const": "planner" },
        "decision": { "enum": ["plan_ready", "plan_final", "needs_expansion", "context_answer"] },
        "plan": { "$ref": "#/$defs/plan", "description": "Required with plan_ready and plan_final" },
        "debate_dispositions": {
          "description": "Synthesis and revise: one entry per open debate item",
          "type": "array",
          "items": { "type": "object", "required": ["id", "decision"], "properties": { "id": { "type": "string" }, "decision": { "enum": ["accept", "reject"] }, "note": { "type": "string" } } }
        },
        "new_todos": { "type": "array", "items": { "$ref": "#/$defs/todo" }, "description": "context_answer: todos the answer adds; they join the Implementer's current session" }
      }
    },
    {
      "properties": {
        "role": { "const": "plan_debater" },
        "decision": { "enum": ["no_findings", "findings", "agree", "needs_expansion"] },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "verdicts": {
          "description": "Rebuttal: the Debater's verdict on the Planner's answer to open items",
          "type": "array",
          "items": { "type": "object", "required": ["id", "verdict"], "properties": { "id": { "type": "string" }, "verdict": { "enum": ["resolved", "conceded", "upheld"] }, "note": { "type": "string" } } }
        }
      }
    },
    {
      "properties": {
        "role": { "const": "implementer" },
        "decision": { "enum": ["implemented", "needs_context", "handover_ready"] },
        "todos_done": { "$ref": "#/$defs/ids", "description": "Implementation: the todos of the session it finished; open ones get one follow-up session" },
        "files_changed": { "$ref": "#/$defs/paths" },
        "notes": { "description": "Choices made where the plan left a small gap", "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
        "resolutions": {
          "description": "Repair, optional (the brief asks for one per finding): fixed or not_fixed; the note names the instances fixed and the search",
          "type": "array",
          "items": { "type": "object", "required": ["id", "status"], "properties": { "id": { "type": "string" }, "status": { "enum": ["fixed", "not_fixed"] }, "note": { "type": "string" }, "tests": { "type": "array", "items": { "type": "string" }, "description": "Optional: the testcases that prove the finding fixed across its scope" } } }
        },
        "context_request": {
          "description": "Required with needs_context: a question that blocks the work; the Planner answers it in plan.md",
          "type": "object",
          "required": ["question"],
          "properties": { "question": { "type": "string" }, "reason": { "type": "string" } }
        },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    },
    {
      "properties": {
        "role": { "const": "tester" },
        "decision": { "enum": ["pass", "fail"] },
        "tests_written": { "$ref": "#/$defs/paths" },
        "excluded_tests": { "type": "array", "items": { "$ref": "#/$defs/excluded_test" }, "description": "Tests unavailable in this phase; each names its verification limitation and is never pass evidence" },
        "failures": { "type": "array", "items": { "type": "object", "required": ["id", "summary"], "properties": { "id": { "type": "string" }, "gate_id": { "type": "string" }, "summary": { "type": "string" }, "files": { "$ref": "#/$defs/paths" } } } },
        "manual_gate_reports": { "$ref": "#/$defs/reports" },
        "resolutions": {
          "description": "After a review repair, optional: per finding in the delta, fixed (verified by tests) or not_fixed",
          "type": "array",
          "items": { "type": "object", "required": ["id", "status"], "properties": { "id": { "type": "string" }, "status": { "enum": ["fixed", "not_fixed"] }, "note": { "type": "string" }, "tests": { "type": "array", "items": { "type": "string" }, "description": "Optional: the testcases that prove the finding fixed across its scope" } } }
        }
      }
    },
    {
      "properties": {
        "role": { "const": "reviewer" },
        "decision": { "enum": ["approve", "changes_requested"] },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" }, "description": "Non-empty with changes_requested" },
        "manual_gate_reports": { "$ref": "#/$defs/reports" }
      }
    },
    {
      "properties": {
        "role": { "const": "worker" },
        "decision": { "const": "answered" },
        "evidence": { "type": "array", "items": { "type": "object", "required": ["path", "note"], "properties": { "path": { "type": "string" }, "lines": { "type": "string" }, "note": { "type": "string" } } } }
      }
    }
  ],
  "$defs": {
    "ids": { "type": "array", "items": { "type": "string" } },
    "paths": { "type": "array", "items": { "type": "string" } },
    "todo": {
      "type": "object",
      "required": ["id", "title"],
      "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "section": { "type": "string", "description": "The plan phase (section of plan.md)" } }
    },
    "plan": {
      "type": "object",
      "required": ["todos"],
      "properties": {
        "todos": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/todo" } },
        "sessions": { "type": "array", "items": { "$ref": "#/$defs/ids" }, "description": "Implementer sessions: contiguous todo groups, one run each. Unknown ids are dropped and unlisted todos join the last session." },
        "requirements": { "type": "object", "additionalProperties": { "$ref": "#/$defs/ids" }, "description": "Requirement id -> todo or deferral ids (a hint for the Debater, never a check)" },
        "deferrals": {
          "type": "array",
          "items": { "type": "object", "required": ["id", "what", "to_phase"], "properties": { "id": { "type": "string" }, "what": { "type": "string" }, "to_phase": { "type": "string" }, "interim": { "type": "string" }, "requirements": { "$ref": "#/$defs/ids" } } }
        }
      }
    },
    "finding": {
      "type": "object",
      "required": ["id", "summary"],
      "properties": {
        "id": { "type": "string" },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "summary": { "type": "string" },
        "files": { "$ref": "#/$defs/paths" },
        "section": { "type": "string", "description": "Plan Debater: the plan section" },
        "suggestion": { "type": "string", "description": "Plan Debater: the change that closes it" },
        "fix": { "type": "string", "description": "Reviewer: the condition the repair must meet" },
        "owner": { "enum": ["implementer", "tester"], "description": "Reviewer: the role that fixes it (default implementer)" },
        "plan_ref": { "type": "string", "description": "Reviewer, optional: the plan item the code is measured against (T-4, Decision 5), a requirement id the plan does not cover, or defect" },
        "scope": { "type": "string", "description": "Reviewer, optional: where the rule applies and how to find every instance (a search, the entry points)" }
      }
    },
    "expansion": {
      "type": "object",
      "required": ["kind", "id", "question", "reason"],
      "properties": { "kind": { "enum": ["document", "phase"] }, "id": { "type": "string" }, "question": { "type": "string" }, "reason": { "type": "string" } }
    },
    "excluded_test": {
      "type": "object",
      "required": ["id", "reason", "limitation"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 }, "limitation": { "type": "string", "minLength": 1 } }
    },
    "reports": { "type": "array", "items": { "type": "object", "required": ["gate_id", "path"] } }
  }
}
